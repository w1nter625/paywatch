# Testnet keys only. Never commit a real private key.
# Preferred: keep the key in .secrets/private_key.txt (gitignored) and export:
#   export PRIVATE_KEY="$(tr -d '[:space:]' < .secrets/private_key.txt)"
# PRIVATE_KEY=0x...
# WATCHED_WALLET=0x...
# If forge/cast get HTTP 403 from lasna-rpc.rnk.dev, run scripts/lasna-proxy.py and set:
# LASNA_RPC=http://127.0.0.1:8549
